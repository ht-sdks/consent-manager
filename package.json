{
  "name": "@ht-sdks/consent-manager",
  "version": "0.0.1",
  "description": "Drop-in consent management plugin for Hightouch Events Browser SDK",
  "keywords": [
    "gdpr",
    "tracking",
    "events-sdk-js-browser"
  ],
  "author": "Hightouch <engineering@hightouch.com>",
  "repository": "https://github.com/ht-sdks/consent-manager",
  "homepage": "https://github.com/ht-sdks/consent-manager",
  "license": "MIT",
  "main": "commonjs/index.js",
  "module": "esm/index.js",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "files": [
    "commonjs",
    "esm",
    "standalone",
    "types",
    "src"
  ],
  "volta": {
    "node": "16.20.2"
  },
  "scripts": {
    "test": "jest src/__tests__",
    "prepublishOnly": "npm run clean && npm run build",
    "dev": "concurrently 'npm run build-standalone --watch' 'npx start-storybook -s ./ -p 9009'",
    "build-commonjs": "tsc --outDir commonjs --module CommonJS --inlineSourceMap",
    "build-esm": "tsc --module es2015 --outDir esm --inlineSourceMap",
    "build-standalone": "webpack",
    "build": "concurrently --names \"commonjs,esm,standalone\" \"npm run build-commonjs\" \"npm run build-esm\" \"npm run build-standalone\"",
    "clean": "rm -rf commonjs esm standalone storybook-static types",
    "standalone-hash": "shasum -b -a 256 standalone/consent-manager.js | xxd -r -p | base64",
    "build-storybook": "npm run build-standalone && build-storybook && cp -r ./standalone ./storybook-static/standalone",
    "deploy-storybook": "storybook-to-ghpages --existing-output-dir=storybook-static",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "size": "size-limit"
  },
  "dependencies": {
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "@segment/in-regions": "^1.2.0",
    "@segment/top-domain": "^3.0.0",
    "emotion": "^9.1.2",
    "events": "^3.3.0",
    "isomorphic-fetch": "^3.0.0",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.1",
    "prop-types": "^15.6.1",
    "styled-components": "^5.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.6.2",
    "@segment/in-eu": "^0.3.0",
    "@storybook/addon-actions": "^5.2.3",
    "@storybook/addon-info": "^5.2.3",
    "@storybook/addon-links": "^5.2.3",
    "@storybook/addon-options": "^5.2.3",
    "@storybook/addon-storysource": "^5.2.3",
    "@storybook/addons": "^5.2.3",
    "@storybook/cli": "^5.2.3",
    "@storybook/react": "^5.2.3",
    "@storybook/storybook-deployer": "^2.8.1",
    "@types/enzyme": "^3.10.19",
    "@types/enzyme-adapter-react-16": "^1.0.9",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.25",
    "@types/nock": "^11.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "@types/sinon": "^7.5.2",
    "@types/storybook__react": "^4.0.2",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "babel-loader": "^8.0.6",
    "concurrently": "^8.2.2",
    "enzyme": "^3.10.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-react": "^7.16.0",
    "evergreen-ui": "^3.0.0",
    "file-loader": "^4.2.0",
    "husky": "^3.0.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^7.0.4",
    "nock": "^13.5.6",
    "preact": "^10.0.0",
    "prettier": "^1.19.1",
    "pretty-quick": "^1.11.1",
    "prismjs": "^1.17.1",
    "raw-loader": "^3.1.0",
    "react": "^16.10.2",
    "react-docgen-typescript-loader": "^3.7.2",
    "react-dom": "^16.10.2",
    "react-simple-code-editor": "^0.10.0",
    "react-syntax-highlighter": "^11.0.2",
    "sinon": "^5.0.7",
    "size-limit": "^13.0.3",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^4.8.2",
    "webpack-cli": "^3.1.1"
  },
  "peerDependencies": {
    "react": "^18.1.0",
    "react-dom": "^18.1.0"
  },
  "jest": {
    "preset": "ts-jest/presets/js-with-ts",
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./test/setupTests.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx|js)$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!nanoid/)"
    ],
    "moduleNameMapper": {
      "^nanoid$": "<rootDir>/node_modules/nanoid/index.browser.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/types/",
      "<rootDir>/commonjs/",
      "<rootDir>/esm/",
      "<rootDir>/standalone/"
    ]
  },
  "size-limit": [
    {
      "name": "esm",
      "path": "esm/index.js",
      "limit": "30 KB",
      "gzip": true
    },
    {
      "name": "standalone",
      "path": "standalone/consent-manager.js",
      "limit": "50 KB",
      "gzip": true,
      "disablePlugins": ["@size-limit/esbuild"]
    }
  ],
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged --pattern '**/*.{ts,tsx,js,jsx}'"
    }
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "storybook-deployer": {
    "gitUsername": "GitHub Pages Bot",
    "gitEmail": "engineering@hightouch.com",
    "commitMessage": "Deploy Storybook to GitHub Pages [skip ci]"
  }
}
